# Copy this file to .env and replace every required placeholder before running
# `docker compose up --build`.

# External PostgreSQL connection (for example, Neon pooled connection).
NEON_DB_HOST=your-neon-pooler-host
NEON_DB_PORT=5432
NEON_DB_NAME=neondb
NEON_DB_USERNAME=your-neon-username
NEON_DB_PASSWORD=your-neon-password

SPRING_DATASOURCE_URL=jdbc:postgresql://${NEON_DB_HOST}:${NEON_DB_PORT}/${NEON_DB_NAME}?sslmode=require&channelBinding=require
SPRING_DATASOURCE_USERNAME=${NEON_DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${NEON_DB_PASSWORD}

BACKEND_PORT=8080
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-characters
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Optional runtime tuning and browser/mobile CORS configuration.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
GEMINI_CONNECT_TIMEOUT_MS=10000
GEMINI_READ_TIMEOUT_MS=60000
OVERPASS_CONNECT_TIMEOUT_MS=10000
OVERPASS_READ_TIMEOUT_MS=60000
CORS_ALLOWED_ORIGIN_PATTERNS=*
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=/tmp/uploads
