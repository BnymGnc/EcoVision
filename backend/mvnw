#!/bin/sh
BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
JAVACMD=java
if [ -n "$JAVA_HOME" ]; then JAVACMD="$JAVA_HOME/bin/java"; fi

if [ "$1" = "spring-boot:run" ]; then
  "$JAVACMD" $MAVEN_OPTS -Dmaven.multiModuleProjectDirectory="$BASE_DIR" \
    -cp "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" \
    org.apache.maven.wrapper.MavenWrapperMain -DskipTests clean package || exit $?
  exec "$JAVACMD" -jar "$BASE_DIR/target/backend-0.0.1-SNAPSHOT.jar"
fi

exec "$JAVACMD" $MAVEN_OPTS -Dmaven.multiModuleProjectDirectory="$BASE_DIR" \
  -cp "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
